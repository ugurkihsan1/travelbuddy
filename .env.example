# Optional public, read-only backend adapter. Never put provider API keys here.
# GET ?stopId=... returns {"arrivals":[{"line":"...","destination":"...","minutes":4,"updatedAt":"2026-10-08T10:00:00Z"}]}
VITE_TRANSIT_API_URL=

# Optional public venue API base endpoint. Same-origin /api/venues is the default.
# Keep credentials on the server.
# VITE_VENUE_API_URL=https://your-backend.example/api/venues
